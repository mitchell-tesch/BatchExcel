<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <ApplicationIcon>Resources\app_icon.ico</ApplicationIcon>
        <!-- Informational SemVer (shown in About / file metadata). Override at pack/publish
             time with `-p:Version=...` from CI so the tag drives the version. -->
        <Version>1.1.0</Version>
        <AssemblyVersion>1.1.0.0</AssemblyVersion>
        <FileVersion>1.1.0.0</FileVersion>
        <InformationalVersion>1.1.0</InformationalVersion>
        <Authors>Mitchell Tesch</Authors>
        <Product>BatchExcel</Product>
        <Copyright>Copyright © 2026 Mitchell Tesch</Copyright>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="ClosedXML" Version="0.105.0" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
        <!-- Pinned explicitly so a future ClosedXML drop doesn't silently change the
             version we write OpenXML against (used by BatchWorkbookReader, TemplateHeaderWriter). -->
        <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1" />
        <PackageReference Include="WPF-UI" Version="4.3.0" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="Resources\BatchExcel_template.xlsx">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Resource Include="Resources\app_icon.ico" />
        <Resource Include="Resources\app_icon.png" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="BatchExcel.Tests" />
    </ItemGroup>

</Project>
